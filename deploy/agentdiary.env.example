# API Key 由你手动填入,见部署说明。填好后 sudo systemctl restart agentdiary-api
DASHSCOPE_API_KEY=REPLACE_ME
AGENTDIARY_DATA_DIR=/var/lib/agentdiary
CORS_ORIGINS=*
DISTILL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DISTILL_MODEL=qwen3.7-plus
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.7-plus
